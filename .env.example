# Copy to .env and fill in. Never commit .env.

# Telegram: create a bot with @BotFather, add it as admin to your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel_or_numeric_id

# Exchange (public price data needs no API key)
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=4h

# Strategy. Run `python -m signal_bot.optimize` and paste the best TEST settings here.
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200        # 0 = no trend filter
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
ADX_MIN=20           # 0 = no ADX filter
STOP_ATR_MULT=2.0
TAKE_PROFIT_RR=1.0   # lower = higher win rate but smaller wins

# Round-trip fees + slippage in % (Binance spot taker ~0.2% round trip incl. slippage)
FEE_PCT=0.1

POLL_SECONDS=300
STATE_FILE=data/state.json

# true = print signals instead of sending them to Telegram
DRY_RUN=true
